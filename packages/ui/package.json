{
  "name": "@inq/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./icon-button": {
      "types": "./dist/components/icon-button/index.d.ts",
      "import": "./dist/components/icon-button/index.js"
    },
    "./tool-pill": {
      "types": "./dist/components/tool-pill/index.d.ts",
      "import": "./dist/components/tool-pill/index.js"
    },
    "./floating-card": {
      "types": "./dist/components/floating-card/index.d.ts",
      "import": "./dist/components/floating-card/index.js"
    },
    "./slider": {
      "types": "./dist/components/slider/index.d.ts",
      "import": "./dist/components/slider/index.js"
    },
    "./color-picker-pill": {
      "types": "./dist/components/color-picker-pill/index.d.ts",
      "import": "./dist/components/color-picker-pill/index.js"
    },
    "./modal": {
      "types": "./dist/components/modal/index.d.ts",
      "import": "./dist/components/modal/index.js"
    },
    "./brand-badge": {
      "types": "./dist/components/brand-badge/index.d.ts",
      "import": "./dist/components/brand-badge/index.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./text-input": {
      "types": "./dist/components/text-input/index.d.ts",
      "import": "./dist/components/text-input/index.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/components/checkbox/index.js"
    },
    "./switch": {
      "types": "./dist/components/switch/index.d.ts",
      "import": "./dist/components/switch/index.js"
    },
    "./select": {
      "types": "./dist/components/select/index.d.ts",
      "import": "./dist/components/select/index.js"
    },
    "./radio-group": {
      "types": "./dist/components/radio-group/index.d.ts",
      "import": "./dist/components/radio-group/index.js"
    },
    "./toast": {
      "types": "./dist/components/toast/index.d.ts",
      "import": "./dist/components/toast/index.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/components/spinner/index.js"
    },
    "./progress-bar": {
      "types": "./dist/components/progress-bar/index.d.ts",
      "import": "./dist/components/progress-bar/index.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/components/tooltip/index.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/index.d.ts",
      "import": "./dist/components/drawer/index.js"
    },
    "./accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "import": "./dist/components/accordion/index.js"
    },
    "./divider": {
      "types": "./dist/components/divider/index.d.ts",
